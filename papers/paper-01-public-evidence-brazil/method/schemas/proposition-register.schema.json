{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elis-slr.github.io/schemas/proposition-register.schema.json",
  "title": "Paper 1 Proposition Register Schema",
  "description": "Schema for the canonical Paper 1 Proposition Register — the authoritative registry of all methodological propositions against which artifacts are tested. Each proposition must be atomic enough that a single artifact can support, contradict, or test it without ambiguity.",
  "type": "object",
  "required": ["schema_version", "paper_id", "generated_at", "method_version", "propositions", "essential_steps"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Version of this schema"
    },
    "paper_id": {
      "type": "string",
      "const": "ELIS-PAPER-01"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of register generation"
    },
    "method_version": {
      "type": "string",
      "description": "Paper 1 method version (e.g. v0.6.1)"
    },
    "implementation_plan_version": {
      "type": "string",
      "description": "Implementation plan version (e.g. v1.0)"
    },
    "source_documents": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Documents from which propositions were extracted"
    },
    "governance_note": {
      "type": "string",
      "description": "H1 gate status — Proposition Register is NOT operative until H1 human approval"
    },
    "propositions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/proposition"},
      "description": "Canonical list of methodological propositions"
    },
    "essential_steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/essential_step"},
      "description": "Workflow essential steps — propositions map to these"
    }
  },
  "$defs": {
    "proposition": {
      "type": "object",
      "required": [
        "proposition_id", "title", "proposition_text",
        "essential_step_id", "applicability",
        "rationale", "TEST_STATEMENT", "expected_evidence_scope"
      ],
      "properties": {
        "proposition_id": {
          "type": "string",
          "pattern": "^P1-P-\\d{4}$",
          "description": "Stable proposition ID (e.g. P1-P-0001)"
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "description": "Short descriptive title"
        },
        "proposition_text": {
          "type": "string",
          "minLength": 10,
          "description": "One atomic, falsifiable methodological claim per proposition"
        },
        "essential_step_id": {
          "type": "string",
          "pattern": "^ES-\\d{2}$",
          "description": "Reference to the essential workflow step"
        },
        "applicability": {
          "type": "string",
          "enum": ["P1-ART", "P1-LIT", "P1-ART,P1-LIT", "P1-BOTH"],
          "description": "Governance domain this proposition applies to"
        },
        "rationale": {
          "type": "string",
          "minLength": 10,
          "description": "Methodological justification for this proposition"
        },
        "TEST_STATEMENT": {
          "type": "string",
          "minLength": 10,
          "description": "Concrete, falsifiable statement testable against public evidence artifacts"
        },
        "expected_evidence_scope": {
          "type": "string",
          "description": "What kind and approximate volume of evidence is expected to test this proposition"
        },
        "notes": {
          "type": "string",
          "description": "Optional operational notes, cross-references, or caveats"
        },
        "source_decision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P1-DEC-\\d{3}$"
          },
          "minItems": 1,
          "description": "Paper 1 decision records that substantiate this proposition"
        },
        "status": {
          "type": "string",
          "enum": ["current", "superseded", "under-review"],
          "default": "current",
          "description": "H1 gate may update this; all start as current"
        }
      }
    },
    "essential_step": {
      "type": "object",
      "required": ["step_id", "name", "phase", "workflow_order", "description"],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^ES-\\d{2}$"
        },
        "name": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "description": "Phase 0-5 or gate designation"
        },
        "workflow_order": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "human_gate": {
          "type": "string",
          "enum": ["H1", "H2", "H3", "H4"],
          "description": "If this step is a structural human gate"
        },
        "blocks_downstream": {
          "type": "boolean",
          "description": "Whether downstream steps are blocked until this step completes"
        }
      }
    }
  }
}